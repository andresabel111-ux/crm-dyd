# Clave de la API de Anthropic (https://console.anthropic.com). NUNCA la subas al repositorio.
ANTHROPIC_API_KEY=
# Secreto para firmar el estado de cada auditoría (cadena aleatoria larga: openssl rand -hex 32)
STATE_SECRET=
# Códigos de acceso por cliente (JSON). "vence" en formato AAAA-MM-DD.
ACCESS_CODES={"DEMO-2026":{"cliente":"Demo","vence":"2026-12-31"}}
# Opcionales
MODEL=claude-opus-5
EFFORT=high
MAX_PASOS=40
MAX_USD_POR_AUDITORIA=4
# "default" activa el reintento automático en otro modelo si hay un rechazo; "off" lo desactiva
FALLBACKS=default
